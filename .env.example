# Set these in Netlify > Project configuration > Environment variables.
# Replace placeholders only with HTTPS endpoints on a backend you own or may use.
OLM_LOGIN_URL=https://YOUR-OLM-BACKEND.example/api/login
OLM_LOGOUT_URL=https://YOUR-OLM-BACKEND.example/api/logout
OLM_SESSION_URL=https://YOUR-OLM-BACKEND.example/api/session
OLM_EXERCISES_URL=https://YOUR-OLM-BACKEND.example/api/panel/exercises
OLM_DO_EXERCISES_URL=https://YOUR-OLM-BACKEND.example/api/panel/do-exercises
OLM_GET_ANSWERS_URL=https://YOUR-OLM-BACKEND.example/api/panel/get-answers
